{
  "name": "package-booking-proof",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "BOOKING_SESSIONS", "class_name": "BookingSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BookingSession"] }]
}
